#!/bin/bash

# Initialize variables
QUANTUM=""
SAMPLERATE=""
APP_PATH=""

# Set BINARY_PATH with a default fallback to /usr/bin if not already set
BINARY_PATH="${BINARY_PATH:-/usr/bin}"

# Help dialog function
show_help() {
  echo "Usage: $0 [-h] [-q QUANTUM] [-s SAMPLERATE] [-l APP_PATH]"
  echo ""
  echo "Options:"
  echo "  -h            Show this help message and exit."
  echo "  -q QUANTUM    Force the Pipewire session quantum (e.g., 64, 128, 256)."
  echo "  -s SAMPLERATE Force the Pipewire session samplerate (e.g., 44100, 48000)."
  echo "  -l APP_PATH   Full path to the application to launch."
  echo "                (Automatically sets WINENTSYNC=1 for the launched app)."
  echo ""
  echo "Note:"
  echo "  If arguments are omitted, a GUI will prompt for them (requires kdialog or zenity)."
  echo ""
  echo "Example:"
  echo "  $0 -q 64 -s 48000 -l /usr/bin/reaper"
}

# Parse CLI options first
while getopts "hq:s:l:" opt; do
  case ${opt} in
    h )
      show_help
      exit 0
      ;;
    q )
      QUANTUM=$OPTARG
      ;;
    s )
      SAMPLERATE=$OPTARG
      ;;
    l )
      APP_PATH=$OPTARG
      ;;
    \? )
      echo "Invalid option. Run '$0 -h' for help."
      exit 1
      ;;
  esac
done

# Shift parsed options to handle any trailing arguments for the launched app
shift $((OPTIND -1))

# Detect available GUI tool (kdialog preferred, fallback to zenity)
GUI_TOOL=""
if command -v kdialog &> /dev/null; then
    GUI_TOOL="kdialog"
elif command -v zenity &> /dev/null; then
    GUI_TOOL="zenity"
fi

# GUI Prompt Logic
if [ -n "$GUI_TOOL" ]; then
    # Prompt for Quantum if not provided via CLI
    if [ -z "$QUANTUM" ]; then
        if [ "$GUI_TOOL" = "kdialog" ]; then
            QUANTUM=$(kdialog --title "Select Quantum" --combobox "Select Pipewire Session Quantum:" 16 24 32 48 64 96 128 192 256 512 1024 2048 4096)
        else
            QUANTUM=$(zenity --list --title="Select Quantum" --text="Select Pipewire Session Quantum:" --column="Quantum" 16 24 32 48 64 96 128 192 256 512 1024 2048 4096)
        fi
    fi

    # Prompt for Samplerate if not provided via CLI
    if [ -z "$SAMPLERATE" ]; then
        if [ "$GUI_TOOL" = "kdialog" ]; then
            SAMPLERATE=$(kdialog --title "Select Samplerate" --combobox "Select Pipewire Session Samplerate:" 44100 48000 88200 96000 192000)
        else
            SAMPLERATE=$(zenity --list --title="Select Samplerate" --text="Select Pipewire Session Samplerate:" --column="Samplerate" 44100 48000 88200 96000 192000)
        fi
    fi

    # Prompt for Application Path if not provided via CLI
    if [ -z "$APP_PATH" ]; then
        # Ensure the BINARY_PATH ends with a slash so the file selector opens inside the directory
        if [ "$GUI_TOOL" = "kdialog" ]; then
            APP_PATH=$(kdialog --title "Select Application to Launch" --getopenfilename "${BINARY_PATH%%/}/")
        else
            APP_PATH=$(zenity --file-selection --title="Select Application to Launch" --filename="${BINARY_PATH%%/}/")
        fi
    fi
fi

# Apply Quantum if specified
if [ -n "$QUANTUM" ]; then
    pw-metadata -n settings 0 clock.force-quantum "$QUANTUM"
    echo "Pipewire quantum forced to $QUANTUM"
fi

# Apply Samplerate if specified
if [ -n "$SAMPLERATE" ]; then
    pw-metadata -n settings 0 clock.force-rate "$SAMPLERATE"
    echo "Pipewire samplerate forced to $SAMPLERATE"
fi

# Launch application if specified
if [ -n "$APP_PATH" ]; then
    # Check if the path exists AND is an executable file
    if [ -x "$APP_PATH" ] && [ ! -d "$APP_PATH" ]; then
        echo "Launching $APP_PATH with WINENTSYNC=1..."
        env WINENTSYNC=1 "$APP_PATH" "$@"
    elif [ -e "$APP_PATH" ]; then
        echo "Error: '$APP_PATH' exists but is not executable (or is a directory)."
        exit 1
    else
        echo "Error: The application path '$APP_PATH' does not exist."
        exit 1
    fi
else
    echo "No application path provided or selection was canceled. Exiting."
fi
