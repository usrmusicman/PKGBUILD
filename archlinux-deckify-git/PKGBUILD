# Maintainer: Your Name <your@email.com>
# Sysctl Tweaks

pkgname=archlinux-deckify-git
_pkgname=ArchLinuxDeckify
pkgver=r148.04db847
pkgrel=1
arch=('any')
url="https://github.com/usrmusicman/ArchLinuxDeckify"
license=('GPL')
makedepends=('git')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  depends=('catimg' 'gamemode' 'gamescope' 'steam' 'steam-devices' 'bash' 'ntsync-autoload' 'realtime-privileges' 'pipewire' 'iw' 'udiskie')
  pkgdesc="Modular SteamOS-like session for Arch with centralized configuration and profile templates"
  provides=("$pkgname")
  conflicts=("$pkgname")
  install="$pkgname.install"

  optdepends=(
    'kdialog: For the QT file selection dialog'
    'zenity: For the GTK file selection dialog'
    'nvidia-utils: For Nvidia GPU support'
    'gdm: For automatic login support'
    'lightdm: For automatic login support'
    'gamemode: For regular gamemode support'
    'lib32-gamemode: For regular gamemode 32-bit support'
    'lib32-nvidia-utils: For Nvidia 32-bit gaming'
    'lib32-vulkan-radeon: For AMD Vulkan 32-bit support'
    'lib32-vulkan-intel: For Intel GPU 32-bit support'
    'plasma-login-manager: For automatic login support'
    'sddm: For automatic login support'
    'xf86-video-amdgpu: For AMD GPU support'
    'vulkan-radeon: For AMD Vulkan support'
    'vulkan-intel: For Intel GPU support'
  )

  cd "$_pkgname"

  # Create Directories
  mkdir -p "$pkgdir/etc/mkinitcpio.conf.d"
  mkdir -p "$pkgdir/etc/modprobe.d"
  mkdir -p "$pkgdir/etc/modules-load.d"
  mkdir -p "$pkgdir/etc/systemd/system/getty@tty1.service.d"
  mkdir -p "$pkgdir/usr/share/applications"
  mkdir -p "$pkgdir/usr/share/libalpm/hooks"
  mkdir -p "$pkgdir/etc/udev/rules.d"
  mkdir -p "$pkgdir/usr/bin"

  # Install scripts, and hardware startup configs
  install -Dm755 $srcdir/ArchLinuxDeckify/gamescope-app-launcher "$pkgdir/opt/steamos-session/gamescope-app-launcher"
  install -Dm755 $srcdir/ArchLinuxDeckify/steamos-profile-switcher "$pkgdir/opt/steamos-session/steamos-profile-switcher"
  install -Dm755 $srcdir/ArchLinuxDeckify/steamos-session-launcher "$pkgdir/opt/steamos-session/steamos-session-launcher"
  install -Dm755 $srcdir/ArchLinuxDeckify/steamos-session-select "$pkgdir/opt/steamos-session/steamos-session-select"

  # Session Launchers (.desktop)
  install -Dm644 $srcdir/ArchLinuxDeckify/launchers/steamos3-gamepadui.desktop "$pkgdir/usr/share/applications/steamos3-gamepadui.desktop"

  # Install the bash .profile templates
  install -Dm644 $srcdir/ArchLinuxDeckify/config/bash/.bash_profile.gamepadui "$pkgdir/opt/steamos-session/config/bash/.bash_profile.gamepadui"
  install -Dm644 $srcdir/ArchLinuxDeckify/config/bash/.bash_profile.normal "$pkgdir/opt/steamos-session/config/bash/.bash_profile.normal"

  # Install the associated assets
  install -Dm644 $srcdir/ArchLinuxDeckify/assets/icons/steamos-session-icon.png "$pkgdir/opt/steamos-session/assets/icons/steamos-session-icon.png"

  # Create symlink
  ln -s /opt/steamos-session/gamescope-app-launcher "$pkgdir/usr/bin/gamescope-app-launcher"
  ln -s /opt/steamos-session/steamos-profile-switcher "$pkgdir/usr/bin/steamos-profile-switcher"
  ln -s /opt/steamos-session/steamos-session-launcher "$pkgdir/usr/bin/steamos-session-launcher"
  ln -s /opt/steamos-session/steamos-session-select "$pkgdir/usr/bin/steamos-session-select"

  # Install Pacman Hook for Gamescope Capabilities
  cat <<EOF > "$pkgdir/usr/share/libalpm/hooks/gamescope-capabilities.hook"
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = gamescope

[Action]
Description = Restoring setcap 'cap_sys_nice=eip' to gamescope...
When = PostTransaction
Exec = /usr/bin/setcap 'cap_sys_nice=eip' /usr/bin/gamescope
EOF

  # I/O Schedulers
  cat <<EOF > "$pkgdir/etc/udev/rules.d/60-ioschedulers.rules"
# Set BFQ for rotational drives (HDDs)
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"

# Set 'none' for non-rotational NVMe drives
ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="none"

# Set 'none' for non-rotational SATA SSDs
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="none"
EOF

  # Uinput alias modprobe
  cat <<EOF > "$pkgdir/etc/modprobe.d/10-uinput.conf"
alias char-major-10-223 uinput
EOF

  # Performance & Filesystem Modules
  cat <<EOF > "$pkgdir/etc/mkinitcpio.conf.d/10-performance.conf"
MODULES+=(ntsync ext4 nls_ascii nls_utf8)
EOF

  # Force uinput module to load at boot
  cat <<EOF > "$pkgdir/etc/modules-load.d/uinput.conf"
uinput
EOF

  # Udev rule to allow the 'input' group to use it (Crucial for Steam/Controllers)
  cat <<EOF > "$pkgdir/etc/udev/rules.d/99-uinput.rules"
KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
EOF
}
